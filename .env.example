# Copy to .env and fill in. NEVER commit .env.
# Alpaca Market Data (SIP feed). Paper account key is fine for research.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets

# SEC EDGAR requires a descriptive User-Agent: "Name email"
SEC_USER_AGENT=Your Name your@email

# FRED (optional, risk-free cross-check)
FRED_API_KEY=

# Wikipedia MediaWiki API User-Agent (descriptive)
WIKI_USER_AGENT=tactic-mob-research your@email

